{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "height": 18,
        "padding": {"top": 2}
    },
    "display": {
        "separator": "   "
    },
    "modules": [
        /*{
            "type": "colors",
            "paddingLeft": 25,
            "symbol": "circle"
        },*/
        {
            "type":"title",
            "color": {
                "user":"red",
                //"at":"",
                "host":"red"
            },
            "format" : "                         {6}{7}{8}"
        },
        {
            "type": "custom",
            "format": "\u001b[33m┌─────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "\u001b[33m└─────────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[34m┌─────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "blue"
        },
        {
            "type": "de", //desktop
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├󰧨",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": "│ ├󰸉",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[34m└─────────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[32m┌─────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "host",
            
            "key": "󰌢 PC", //laptop
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "green"
            // "forceVulkan": true
        },
        {
            "type": "display",
            "key": "│ ├󰍹",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├󰉉",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├",
            "keyColor": "green"
        },
        /*{
            "type": "swap",
            "key": "│ ├󰓡",
            "keyColor": "green"
        },*/
        {
            "type": "localip",
            "key": "│ ├󰩟",
            "keyColor": "green",
            "compact": true
        },
        /*{
            "type": "publicip",
            "key": "│ ├󰩠",
            "keyColor": "green"
        },*/
        {
            "type": "wifi",
            "key": "│ ├",
            "keyColor": "green",
            "format": "{4}" // ssid
        },
        {
            "type": "battery",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ └󰅐",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[32m└─────────────────────────────────────────────────────────────┘"
        },
        /*{
            "type": "custom",
            "format": "\u001b[36m┌─────────────────────────────────────────────────────────────┐"
        },
        {
            "type": "sound",
            "key": " SND",
            "keyColor": "cyan"
        },
        {
            "type": "player",
            "key": "│ ├󰥠",
            "keyColor": "cyan"
        },
        {
            "type": "media",
            "key": "│ └󰝚",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "\u001b[36m└─────────────────────────────────────────────────────────────┘"
        },*/
        {
            "type": "colors",
            "paddingLeft": 25,
            "symbol": "circle"
        }
    ]
}
